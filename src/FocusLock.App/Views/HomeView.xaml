<UserControl x:Class="FocusLock.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280">
    <Grid Background="#F8FAFC">
        <!-- Sharp Container Card -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="500" Padding="40" CornerRadius="0"
                Background="#FFFFFF" BorderBrush="#0F172A" BorderThickness="2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.1" Color="#000000"/>
            </Border.Effect>

            <StackPanel HorizontalAlignment="Center" Width="420">
                <!-- Sharp App Logo Icon -->
                <Image Source="pack://application:,,,/Assets/Logo.png" Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,20" RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- Title & Subtitle -->
                <TextBlock x:Name="TxtAppName" Text="FlyLock Browser" FontSize="26" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Enter your Assessment Access Code below to begin your exam session." 
                           TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="#475569" LineHeight="20" Margin="0,0,0,28"/>

                <!-- Authenticated Google Student Email Badge -->
                <Border Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1.5" Padding="12,10" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Vertical">
                            <TextBlock Text="AUTHENTICATED STUDENT" FontSize="10" FontWeight="Bold" Foreground="#047857"/>
                            <TextBlock x:Name="TxtStudentBadge" Text="Google Verified Account" FontSize="13" FontWeight="Bold" Foreground="#065F46" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnSwitchAccount" Grid.Column="1" Click="BtnSwitchAccount_Click" Content="Switch Account" FontSize="11" FontWeight="Bold" Foreground="#2563EB" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Code Input Field -->
                <TextBlock Text="ACCESS CODE" FontSize="11" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6"/>
                <Border Background="#F1F5F9" CornerRadius="0" BorderBrush="#0F172A" BorderThickness="2" Padding="12,10" Margin="0,0,0,16">
                    <TextBox x:Name="TxtAccessCode" 
                             Background="Transparent" BorderThickness="0" 
                             Foreground="#0F172A" FontSize="20" FontWeight="Bold" 
                             FontFamily="Consolas" TextAlignment="Center" 
                             KeyDown="TxtAccessCode_KeyDown"
                             CaretBrush="#0F172A"/>
                </Border>

                <!-- Error Message -->
                <TextBlock x:Name="TxtCodeError" Text="Please enter a valid assessment code to continue." 
                           FontSize="12" FontWeight="SemiBold" Foreground="#DC2626" TextAlignment="Center" 
                           Visibility="Collapsed" Margin="0,0,0,16"/>

                <!-- Sharp Button -->
                <Button x:Name="BtnStartExam" Click="BtnStartExam_Click" Height="48" Margin="0,0,0,20" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#0F172A"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="15"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="0" Padding="0" BorderBrush="#0F172A" BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2563EB"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="START ASSESSMENT" VerticalAlignment="Center"/>
                        <TextBlock Text=" →" FontSize="16" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>

                <!-- Sharp Lockdown Badge -->
                <Border Background="#F1F5F9" CornerRadius="0" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🛡️ " FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Secure Lockdown Mode Active" FontSize="11" Foreground="#334155" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
