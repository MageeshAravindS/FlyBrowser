<Window x:Class="FocusLock.App.Views.ExitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Proctor Exit Authorization" Height="380" Width="480"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True">
    <Grid>
        <Border Background="#FFFFFF" BorderBrush="#0F172A" BorderThickness="2" CornerRadius="0" Padding="32">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.2" Color="#000000"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="0" Background="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="🔑" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                </Border>

                <TextBlock Text="Proctor Authorization Required" FontSize="20" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Enter the proctor password to unlock and exit FlyLock Browser." 
                           FontSize="13" Foreground="#475569" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24"/>

                <TextBlock Text="PROCTOR PASSWORD" FontSize="11" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6"/>
                <Border Background="#F1F5F9" CornerRadius="0" BorderBrush="#0F172A" BorderThickness="2" Padding="10,8" Margin="0,0,0,12">
                    <PasswordBox x:Name="TxtPassword" 
                                 Background="Transparent" BorderThickness="0" 
                                 Foreground="#0F172A" FontSize="16" FontWeight="Bold"
                                 KeyDown="TxtPassword_KeyDown" CaretBrush="#0F172A"/>
                </Border>

                <TextBlock x:Name="TxtError" Text="Invalid proctor password. Please try again." 
                           FontSize="12" FontWeight="Bold" Foreground="#DC2626" TextAlignment="Center" 
                           Visibility="Collapsed" Margin="0,0,0,16"/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="CANCEL" Click="BtnCancel_Click" Height="44" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="0" BorderBrush="#0F172A" BorderThickness="1">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E2E8F0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Grid.Column="2" Content="UNLOCK EXIT" Click="BtnSubmit_Click" Height="44" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#0F172A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="0" BorderBrush="#0F172A" BorderThickness="1">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2563EB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
